{
  "name": "anon-reddit",
  "version": "1.0.0",
  "description": "AnonNet - Anonymous Reddit-like discussion boards and real-time live chat",
  "main": "server/server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/server.js",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "dev:server": "node server/server.js",
    "dev:client": "npm --prefix client run dev",
    "dev": "node server/server.js"
  },
  "keywords": [
    "anonymous",
    "reddit",
    "chat",
    "websockets",
    "boards",
    "forum"
  ],
  "author": "AnonNet",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "ws": "^8.22.1"
  }
}
